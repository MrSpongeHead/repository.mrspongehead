<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.spongetv" name="SpongeTV" version="0.5.10" provider-name="MrSpongeHead">
    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
        <import addon="script.module.requests" version="2.27.0"/>
        <import addon="script.module.beautifulsoup4" version="4.9.3"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Films and TV with Trakt, TMDB and Premiumize</summary>
        <description lang="en_GB">SpongeTV brings Trakt syncing, TMDB metadata, Premiumize and your own provider packages together in one add-on. This is a stage 4 test build: browsing, metadata, Trakt, provider packages and playback through Premiumize.</description>
        <disclaimer lang="en_GB">SpongeTV includes no content providers. You are responsible for the provider packages you install.</disclaimer>
        <platform>all</platform>
        <license>GPL-3.0-or-later</license>
        <source>https://github.com/MrSpongeHead/plugin.video.spongetv</source>
        <reuselanguageinvoker>false</reuselanguageinvoker>
        <news>0.5.10: The Trakt entry is back at the top of the context menu on films, shows, seasons and episodes. &quot;Use this view for ...&quot; (added in 0.5.7) had replaced it; it now comes after SpongeTV's own entries.
Earlier changes: changelog.txt</news>
        <assets>
            <icon>resources/media/icon.png</icon>
            <fanart>resources/media/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
<addon id="repository.mrspongehead" name="MrSpongeHead Repository" version="1.0.0" provider-name="MrSpongeHead">
    <extension point="xbmc.addon.repository" name="MrSpongeHead Repository">
        <dir>
            <info compressed="false">https://mrspongehead.github.io/repository.mrspongehead/zips/addons.xml</info>
            <checksum>https://mrspongehead.github.io/repository.mrspongehead/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://mrspongehead.github.io/repository.mrspongehead/zips/</datadir>
            <hashes>false</hashes>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Add-ons by MrSpongeHead, including SpongeTV</summary>
        <description lang="en_GB">Installs and keeps up to date the add-ons published by MrSpongeHead.</description>
        <platform>all</platform>
        <license>GPL-3.0-or-later</license>
        <source>https://github.com/MrSpongeHead/repository.mrspongehead</source>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
</addons>
